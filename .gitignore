.kotlin/

# Gradle
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar
!**/src/main/**/build/
!**/src/test/**/build/

# IntelliJ IDEA
.idea/
*.iws
*.iml
*.ipr
out/
!**/src/main/**/out/
!**/src/test/**/out/

# Eclipse
.apt_generated/
.classpath
.factorypath
.project
.settings/
.springBeans
.sts4-cache
bin/
!**/src/main/**/bin/
!**/src/test/**/bin/

# NetBeans
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/

# VS Code
.vscode/

# Mac
.DS_Store

# Android
*.apk
*.aab
*.ap_
*.dex
captures/
output.json

# Performance analysis artifacts (keep only final reports)
build/perf-dumps/
build/llvm-stats/
build/reports/profile/
*.hprof

# Native binaries
*.exe
*.dll
*.so
*.dylib
*.kexe

# Protobuf generated files (will be regenerated)
**/generated/
**/proto/
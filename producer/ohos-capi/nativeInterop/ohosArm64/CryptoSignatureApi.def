package = platform.CryptoArchitectureKit.CryptoSignatureApi
headers = CryptoArchitectureKit/crypto_signature.h
headerFilter = CryptoArchitectureKit/crypto_signature.h
depends = CryptoAsymKeyApi CryptoCommonApi
linkerOpts = -Wl,--push-state -Wl,--as-needed -lohcrypto -Wl,--pop-state
language = C++
compilerOpts = -std=c++17

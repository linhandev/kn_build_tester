package = platform.LocalizationKit.Resourcemanager
headers = resourcemanager/resmgr_common.h resourcemanager/ohresmgr.h
headerFilter = resourcemanager/**
depends = ArkUI_NativeModule RawFile
linkerOpts = -Wl,--push-state -Wl,--as-needed -lohresmgr -Wl,--pop-state
language = C++
compilerOpts = -std=c++17

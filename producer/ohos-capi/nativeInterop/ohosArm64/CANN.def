package = platform.CANNKit.CANN
depends = NeuralNetworkRuntime
headers = CANNKit/hiai_tensor.h \
    CANNKit/hiai_helper.h \
    CANNKit/hiai_options.h \
    CANNKit/hiai_single_op.h \
    CANNKit/hiai_aipp_param.h
headerFilter = CANNKit/**
linkerOpts = -Wl,--push-state -Wl,--as-needed -lhiai_foundation -Wl,--pop-state
language = C++
compilerOpts = -std=c++17
#harmonyOS SDK Only

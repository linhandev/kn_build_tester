package = platform.MediaKit.AVPlayer
headers = multimedia/player_framework/avplayer.h multimedia/player_framework/avplayer_base.h
headerFilter = multimedia/player_framework/**
depends = Core NativeWindow OHAudio CodecBase
linkerOpts = -Wl,--push-state -Wl,--as-needed -lavplayer -Wl,--pop-state
language = C++
compilerOpts = -std=c++17

package = platform.InputKit.Input
headers = multimodalinput/oh_input_manager.h multimodalinput/oh_axis_type.h multimodalinput/oh_key_code.h multimodalinput/oh_pointer_style.h
headerFilter = multimodalinput/**
linkerOpts = -Wl,--push-state -Wl,--as-needed -lohinput -Wl,--pop-state
language = C++
compilerOpts = -std=c++17

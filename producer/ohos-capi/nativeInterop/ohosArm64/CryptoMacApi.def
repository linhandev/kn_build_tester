package = platform.CryptoArchitectureKit.CryptoMacApi
headers = CryptoArchitectureKit/crypto_mac.h
headerFilter = CryptoArchitectureKit/crypto_mac.h
depends = CryptoCommonApi CryptoSymKeyApi
linkerOpts = -Wl,--push-state -Wl,--as-needed -lohcrypto -Wl,--pop-state
language = C++
compilerOpts = -std=c++17

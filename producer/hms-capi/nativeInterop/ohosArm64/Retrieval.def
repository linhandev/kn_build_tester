package = platform.DataAugmentationKit.Retrieval
depends = RDB
headers = dataaugmentation/retrieval/aip_retrieval.h \
    dataaugmentation/retrieval/aip_retrieval_condition.h \
    dataaugmentation/retrieval/aip_retrieval_condition_vector.h \
    dataaugmentation/retrieval/aip_retrieval_query.h \
    dataaugmentation/retrieval/aip_retrieval_record.h
headerFilter = dataaugmentation/retrieval/**
linkerOpts = -Wl,--push-state -Wl,--as-needed -lnative_aip_retrieval_ndk.z -Wl,--pop-state
language = C++
compilerOpts = -std=c++17
#harmonyOS SDK Only 

